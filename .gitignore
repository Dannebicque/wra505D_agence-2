# Filet de securite : un npm install lance a la racine par erreur ne doit pas
# se retrouver dans une PR.
node_modules/

.DS_Store
**/.DS_Store
.idea
.vscode/*
!.vscode/extensions.json
.claude/settings.local.json
*.log

# Base reprise de uniServices.
/uniservices/vendor
/uniservices/back/vendor
/uniservices/back/var
/uniservices/back/config/jwt/*.pem
/uniservices/node_modules
/uniservices/**/node_modules
/uniservices/back/public/build
/uniservices/cypress/videos
/uniservices/cypress/screenshots
