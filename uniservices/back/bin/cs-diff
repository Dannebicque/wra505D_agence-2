#!/usr/bin/env sh
# Style PSR-12 des seuls fichiers PHP modifiés depuis la branche de base (origin/develop par
# défaut, BASE=... pour une autre). Vérifie par défaut ; --fix corrige.
set -e

cd "$(dirname "$0")/.."
racine=$(git rev-parse --show-toplevel)
base=${BASE:-origin/develop}
depart=$(git merge-base "$base" HEAD)

fichiers=$(cd "$racine" && {
    git diff --name-only --diff-filter=ACMR "$depart" -- '*.php'
    git ls-files --others --exclude-standard -- '*.php'
} | sort -u | sed "s#^#$racine/#")

if [ -z "$fichiers" ]; then
    echo "Aucun fichier PHP modifié depuis $base."
    exit 0
fi

# Un fichier par ligne : le chemin du projet contient des espaces.
IFS='
'
# shellcheck disable=SC2086
set -- "$1" $fichiers
unset IFS

# path-mode=intersection : seuls les fichiers modifiés que la configuration couvre sont traités.
if [ "$1" = "--fix" ]; then
    shift
    exec vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --path-mode=intersection -- "$@"
fi
shift
exec vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --path-mode=intersection --dry-run --diff -- "$@"
