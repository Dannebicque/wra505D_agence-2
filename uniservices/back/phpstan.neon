parameters:
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml

    level: 10

    doctrine:
        # Le vrai mapping, types Carbon compris : sans lui, PHPStan croit que la base renvoie des DateTime.
        objectManagerLoader: tests/object-manager.php
        # Une entité neuve est vide avant d'être remplie : une propriété nullable sur une colonne
        # NOT NULL est le motif Doctrine voulu, pas une erreur.
        allowNullablePropertyForRequiredField: true

    paths:
        - src
        - ../packages/auth-bundle/src
        - ../packages/document-bundle/src
        - ../packages/intranet-bundle/src
        - ../packages/unifolio-bundle/src
        - ../packages/helpdesk-bundle/src
        - ../packages/questionnaire-bundle/src
        - ../packages/stage-bundle/src
