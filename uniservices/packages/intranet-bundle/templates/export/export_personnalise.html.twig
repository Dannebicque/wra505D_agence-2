<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Export Personnalisé Étudiants</title>
    <style>
        {% include 'pdf/_base_pdf.css.twig' %}
        @page {
            size: A4 landscape;
            margin: 10mm 12mm;
        }
        * {
            box-sizing: border-box;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            font-size: 11px;
            color: {{ document_palette.text }};
            margin: 0;
            padding: 0;
            background: {{ document_palette.surface }};
        }
        .page-group {
            page-break-after: always;
            break-after: page;
        }
        .page-group:last-child {
            page-break-after: avoid;
            break-after: avoid;
        }
        .header-box {
            border-bottom: 2px solid {{ document_palette.primary }};
            padding-bottom: 8px;
            margin-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }
        .header-left h1 {
            margin: 0;
            font-size: 16px;
            font-weight: 800;
            color: {{ document_palette.text }};
            text-transform: uppercase;
        }
        .header-left .subtitle {
            font-size: 11px;
            color: {{ document_palette.muted }};
            margin-top: 2px;
        }
        .badge-group {
            background: {{ document_palette.primary }};
            color: {{ document_palette.on_primary }};
            font-weight: 700;
            font-size: 12px;
            padding: 2px 8px;
            border-radius: 4px;
            display: inline-block;
            margin-bottom: 4px;
        }
        table.custom-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 10px;
        }
        table.custom-table th,
        table.custom-table td {
            border: 1px solid {{ document_palette.border }};
            padding: 4px 6px;
        }
        table.custom-table th {
            background: {{ document_palette.background }};
            font-weight: 700;
            color: {{ document_palette.text }};
            text-align: left;
        }
        table.custom-table tr:nth-child(even) td {
            background: {{ document_palette.background }};
        }
    </style>
</head>
<body>

{% for groupData in data %}
    {% set groupe = groupData.groupe %}
    {% set etudiants = groupData.etudiants %}
    
    <div class="page-group">
        <div class="header-box">
            <div class="header-left">
                <span class="badge-group">Groupe {{ groupe.libelle }}</span>
                <h1>Listing Étudiants</h1>
                <div class="subtitle">Semestre {{ semestre.libelle }} • Année Univ. {{ anneeUniversitaire.libelle|default('') }}</div>
            </div>
            <div style="text-align: right; font-size: 10px; color: {{ document_palette.muted }};">
                Effectif : <strong>{{ etudiants|length }}</strong> étudiant(s)
            </div>
        </div>

        <table class="custom-table">
            <thead>
                <tr>
                    <th style="width: 25px; text-align: center;">#</th>
                    {% for champKey, champLabel in colonnes %}
                        <th>{{ champLabel }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for etudiant in etudiants %}
                    <tr>
                        <td style="text-align: center; color: {{ document_palette.muted }};">{{ loop.index }}</td>
                        {% for champKey, champLabel in colonnes %}
                            <td>{{ etudiant[champKey]|default('') }}</td>
                        {% endfor %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="{{ colonnes|length + 1 }}" style="text-align: center; padding: 20px; color: {{ document_palette.muted }};">
                            Aucun étudiant dans ce groupe.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endfor %}

</body>
</html>
